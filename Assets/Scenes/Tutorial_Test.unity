    - target: {fileID: 7445963329569206127, guid: ed299ca8b4759fd4f873cf15eeaa880b, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "\u5662\u5BF9\u4E86\uFF0C\u4F5C\u4E3A\u8774\u8776\u76D1\u5BDF\u8BB0\u5F55\u7A0B\u5E8F\uFF0C\u6211\u4F1A\u5168\u7A0B\u8BB0\u5F55\u4F60\u7684\u884C\u4E3A\uFF0C\u4E0D\u8981\u8BA9\u6211\u770B\u5230\u6709\u4EFB\u4F55\u8FDD\u80CC\u6B63\u786E\u8DEF\u7EBF\u7684\u4E3E\u52A8\uFF01"
