    - target: {fileID: 7445963329569206127, guid: ed299ca8b4759fd4f873cf15eeaa880b, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "\u90A3\u4E48\u4E0D\u8BF4\u5E9F\u8BDD\u4E86\uFF0C\u5C0F\u5FC3\u8FD9\u91CC\u7684\u5E7D\u6697\u85E4\u8513
        \u4ED6\u4EEC\u5468\u56F4\u7167\u4EAE\u5468\u56F4\u4F5C\u4E3A\u9886\u5730\uFF0C\u4F60\u5982\u679C\u95EF\u5165\uFF0C\u81EA\u5DF1\u770B\u7740\u529E\u5427\uFF08\u55E4\u7B11\uFF09"
