  m_Script: {fileID: 11500000, guid: a0a4ff377afee074b8f300f0ab749cf2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  glowController: {fileID: 1251202724217452567}
  interactPrompt: {fileID: 5475473024260897134}
  dialoguePanel: {fileID: 7513014977839987410}
  dialogueText: {fileID: 4719510606547645973}
  dialogueLines:
  - "\u6B22\u8FCE\u6765\u5230Butterfly Tech.CO\u4E3A\u4F60\u51C6\u5907\u7684\u5B9A\u5236\u5316\u201C\u8BD5\u70BC\u201D\u65C5\u7A0B\uFF0C\u5982\u6709\u5F02\u8BAE\uFF0C\u7EA2\u5149\u4F3A\u5019\uFF01"
  - "(\u7FC5\u8180\u80CC\u540E\u4F20\u6765\u5431\u5431\u7684\u58F0\u97F3\uFF0C\u4F3C\u4E4E\u5F88\u8033\u719F\uFF09"
  - "\u90A3\u4E48\u4E0D\u8BF4\u5E9F\u8BDD\u4E86\uFF0C\u5C0F\u5FC3\u8FD9\u91CC\u7684\u5E7D\u6697\u85E4\u8513
    \u4ED6\u4EEC\u5468\u56F4\u7167\u4EAE\u5468\u56F4\u4F5C\u4E3A\u9886\u5730\uFF0C\u4F60\u5982\u679C\u95EF\u5165\uFF0C\u81EA\u5DF1\u770B\u7740\u529E\u5427\uFF08\u55E4\u7B11\uFF09"
  - "\u5662\u5BF9\u4E86\uFF0C\u4F5C\u4E3A\u8774\u8776\u76D1\u5BDF\u8BB0\u5F55\u7A0B\u5E8F\uFF0C\u6211\u4F1A\u5168\u7A0B\u8BB0\u5F55\u4F60\u7684\u884C\u4E3A\uFF0C\u4E0D\u8981\u8BA9\u6211\u770B\u5230\u6709\u4EFB\u4F55\u8FDD\u80CC\u6B63\u786E\u8DEF\u7EBF\u7684\u4E3E\u52A8\uFF01"
  - "\u6700\u540E\uFF0C\u6211\u529D\u4F60\u5C3D\u5FEB\uFF0C\u4E0D\u7136\u4F60\u5C31\u4F1A\u548C\u8FD9\u4E9B\u5149\u73AF\u4E00\u6837\uFF0C\u5931\u53BB\u7075\u9B42\uFF0C\u5C24\u5176\u662F\u548C\u7EA2\u8272\u5149\u73AF\u4E00\u6837
    \u6210\u4E3A\u85E4\u8513\u7684......\uFF08\u8F7B\u8511\u5730\uFF09"
  typingSpeed: 0.05
  OnDialogueStarted:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 0}
